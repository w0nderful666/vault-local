{
  "name": "vault-local",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "A local-first clipboard vault for saving, searching, and encrypting snippets in the browser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/w0nderful666/vault-local"
  },
  "homepage": "https://w0nderful666.github.io/vault-local/",
  "keywords": [
    "github-pages",
    "frontend",
    "local-first",
    "no-backend",
    "privacy-friendly",
    "vite",
    "react",
    "typescript",
    "clipboard",
    "vault",
    "web-crypto"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "self-test": "node scripts/run-self-test.mjs",
    "preflight": "node scripts/preflight.mjs",
    "release:check": "npm run preflight",
    "test:all": "npm run build && npm run self-test && npm run preflight",
    "test:ci": "npm run test:all"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^1.2.0",
    "@testing-library/react": "^14.1.0",
    "@testing-library/jest-dom": "^6.2.0",
    "jsdom": "^23.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
